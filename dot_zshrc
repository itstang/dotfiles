typeset -U path PATH
path=(
  /opt/homebrew/bin
  "$HOME/bin"
  "$HOME/.cargo/bin"
  /usr/local/go/bin
  $path
)

export EDITOR='nvim'
export LC_ALL=en_US.UTF-8
export EZA_CONFIG_DIR="$HOME/.config/eza"
export XDG_CONFIG_HOME="$HOME/.config"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
unset LS_COLORS

# ── HISTORY ───────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify share_history

# ── COMPLETION SEARCH PATH ────────────────────────────────────────────────────
fpath=(
  /opt/homebrew/share/zsh/site-functions
  /opt/homebrew/share/zsh-completions
  $fpath
)

# ── COMPINIT ──────────────────────────────────────────────────────────────────
autoload -Uz compinit
_zstale=( ~/.zcompdump(N.mh+24) )
if (( $#_zstale )) || [[ ! -s ~/.zcompdump ]]; then
  compinit
else
  compinit -C
fi
unset _zstale

if [[ ! -s ~/.zcompdump.zwc || ~/.zcompdump -nt ~/.zcompdump.zwc ]]; then
  zcompile -R -- ~/.zcompdump.zwc ~/.zcompdump
fi

zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':fzf-tab:*' fzf-flags --style=full --preview-window=right:50%
zstyle ':fzf-tab:*' fzf-min-height 30
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --tree --level=2 --icons --color=always $realpath'
zstyle ':fzf-tab:complete:(nvim|bat|cat|less):*' fzf-preview 'bat --color=always --style=numbers $realpath'

# ── ZGENOM ────────────────────────────────────────────────────────────────────
ZGEN_AUTOLOAD_COMPINIT=0

# Set up fzf key bindings and fuzzy completion
export FZF_DEFAULT_OPTS="
    --style full
    --preview 'fzf-preview.sh {}'
    --height 40%"
export FZF_CTRL_R_OPTS="
    --preview 'echo {2..}'"
source <(fzf --zsh)

source "${HOME}/.zgenom/zgenom.zsh"
zgenom autoupdate

if ! zgenom saved; then
  zgenom load aloxaf/fzf-tab
  zgenom load zdharma-continuum/fast-syntax-highlighting
  zgenom load zsh-users/zsh-autosuggestions
  zgenom load akash329d/zsh-alias-finder
  zgenom save
  zgenom compile "$HOME/.zshrc"
fi

# ── TOOLS ─────────────────────────────────────────────────────────────────────
eval "$(starship init zsh --print-full-init)"
eval "$(fnm env --use-on-cd --shell zsh)"
eval "$(zoxide init zsh --cmd cd)"

export PYENV_ROOT="$HOME/.pyenv"
path=("$PYENV_ROOT/shims" "$PYENV_ROOT/bin" $path)
export PYENV_VIRTUALENV_DISABLE_PROMPT=1

pyenv() {
  unfunction pyenv
  eval "$(command pyenv init -)"
  pyenv "$@"
}

# ── ALIASES ───────────────────────────────────────────────────────────────────
alias mkdir="mkdir -p"
alias zshconfig="$EDITOR ~/.zshrc"
alias szsh="exec zsh"
alias ls='eza --color=always --group-directories-first --icons'
alias ll='eza -la --icons --octal-permissions --group-directories-first'
alias la='eza --long --all --group --group-directories-first'
alias lg="lazygit"
alias nvm="fnm"

alias git-cleanup="$HOME/Develop/git-cleanup.sh"
alias gst='git status'
alias gd='git diff'
alias gco='git checkout'
alias gcb='git checkout -b'
alias glg='git log --stat'
alias gb='git branch'
alias gr='git remote'
alias gsta='git stash push'
alias gstaa='git stash apply'
alias gsts='git stash show --text'

git_main_branch() {
  local b
  for b in main master trunk; do
    git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return }
  done
  echo main
}
ggpush() { git push -u origin HEAD }
gcm()    { git checkout "$(git_main_branch)" }

# ── FUNCTIONS ─────────────────────────────────────────────────────────────────
mkcd() { mkdir -p "$1" && cd "$1" }

function yy() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

git-delete-squashed() {
  local main="$(git_main_branch)"
  git checkout -q "$main"
  git for-each-ref refs/heads/ "--format=%(refname:short)" | while read branch; do
    [[ $branch == "$main" ]] && continue
    mergeBase=$(git merge-base "$main" $branch)
    if [[ $(git cherry "$main" $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == "-"* ]]; then
      git branch -D $branch
    fi
  done
}
