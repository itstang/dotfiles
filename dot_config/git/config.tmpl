[user]
	name = {{ .name }}
	email = {{ .email }}
  signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
  editor = nvim
[init]
  defaultBranch = main
[pull]
	rebase = true
[push]
  autoSetupRemote = true
[checkout]
	defaultRemote = origin
[fetch]
  prune = true
[branch]
  sort = -committerdate
  autoSetupMerge = true
[diff]
  algorithm = histogram
[rebase]
  autoStash = true
  missingCommitsCheck = warn
  autoSquash = true
  missingCommitsCheck = error
