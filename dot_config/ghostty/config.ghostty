font-family = Maple Mono NF
font-style-italic = VictorMono Nerd Font
font-feature = +feat

theme = Catppuccin Mocha
background-opacity = 0.8
background-blur = 10
unfocused-split-opacity = 0.3
macos-titlebar-proxy-icon = hidden
title = " "

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

window-padding-balance = true
window-padding-x = 6
window-padding-y = 2
window-height = 30
window-width = 100
window-title-font-family = FiraCode Nerd Font

macos-titlebar-style = transparent

# Override the native 'edit config' shortcut with the CLI action, respecting ${VISUAL:-${EDITOR}}
#   1. `\x1bq` runs the zsh `push-line-or-edit` widget (bound to alt-q)
#   2. `ghostty +edit-config` is sent to the shell prompt
#   3. `\x0d` enters/executes the command currently on the prompt
keybind = unconsumed:super+,=text:\x1bqghostty +edit-config\x0d
keybind = ctrl+a>\=new_split:right
keybind = ctrl+a>-=new_split:down
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>x=close_surface
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up

custom-shader = shaders/cursor_warp.glsl
